## agentbase environment configuration
## Copy to .env and fill in your values.

## ─── Model ──────────────────────────────────────────────────
## Primary API key (used for model calls)
## Supported: SILICONFLOW_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY, ANTHROPIC_API_KEY, GOOGLE_API_KEY
## The first available key will be used automatically.
SILICONFLOW_API_KEY=
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

## Base URL for OpenAI-compatible providers
## Use this when connecting to a custom OpenAI-compatible endpoint
# OPENAI_BASE_URL=https://api.openai.com/v1
# SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

## ─── PostgreSQL ─────────────────────────────────────────────
## Used for storage, checkpointer, memory, and knowledge base.
## Starts with `docker compose up -d postgres`
## With pgvector image (pgvector/pgvector:pg16) for vector search.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=agentbase
POSTGRES_USER=agentbase
POSTGRES_PASSWORD=agentbase

## Full DSN (overrides individual settings if set)
## Use 127.0.0.1 instead of localhost to avoid IPv6 timeout
## For Docker, use 'postgres' as hostname: postgresql://agentbase:agentbase@postgres:5432/agentbase
# AGENTBASE_CHECKPOINTER__DSN=postgresql://agentbase:agentbase@127.0.0.1:5432/agentbase
# AGENTBASE_STORAGE__DSN=postgresql://agentbase:agentbase@127.0.0.1:5432/agentbase

## ─── API Security ───────────────────────────────────────────
## API Key for authenticating API requests.
## When set, all endpoints (except /health and /metrics) require:
##   Authorization: Bearer <AGENTBASE_API_KEY>
##   or X-API-Key: <AGENTBASE_API_KEY>
## Leave empty to disable auth (dev mode).
AGENTBASE_API_KEY=

## CORS allowed origins (comma-separated).
## Use * to allow all (default). For production, specify explicit origins.
## When origins is *, credentials are automatically disabled (CORS spec).
## Example: AGENTBASE_CORS_ORIGINS=https://app.example.com,https://admin.example.com
AGENTBASE_CORS_ORIGINS=*

## ─── JWT Authentication ─────────────────────────────────────
## Auth type: api_key (default), jwt
## When type=jwt, AGENTBASE_AUTH__SECRET is **required** — the server
## will refuse to start without it. Use a strong random string (>= 32 chars).
# AGENTBASE_AUTH__TYPE=api_key
# AGENTBASE_AUTH__SECRET=  # e.g. python -c "import secrets; print(secrets.token_hex(32))"
# AGENTBASE_AUTH__TOKEN_EXPIRY_HOURS=24

## ─── Rate Limiting ──────────────────────────────────────────
## Enable/disable per-client request rate limiting.
# AGENTBASE_RATE_LIMIT__ENABLED=true
# AGENTBASE_RATE_LIMIT__MAX_REQUESTS=60
# AGENTBASE_RATE_LIMIT__WINDOW_SECONDS=60
# AGENTBASE_RATE_LIMIT__BURST=10

## ─── Metrics ────────────────────────────────────────────────
## Enable Prometheus metrics endpoint at /metrics.
# AGENTBASE_METRICS__ENABLED=true
# AGENTBASE_METRICS__PATH=/metrics

## ─── Application ────────────────────────────────────────────
## Environment: dev, test, staging, prod
AGENTBASE_APP__ENV=dev

## Log level: DEBUG, INFO, WARNING, ERROR
AGENTBASE_APP__LOG_LEVEL=INFO

## Profile — loads configs/default.{profile}.yaml overlay
## Set to dev, staging, prod, etc. (optional)
## Profile files are optional and deep-merged over the base config.
# AGENTBASE_PROFILE=dev

## ─── Runtime ────────────────────────────────────────────────
## Default agent profile (must match a file in configs/agents/)
AGENTBASE_RUNTIME__DEFAULT_AGENT=default

## Workspace directory (relative to project root)
AGENTBASE_RUNTIME__WORKSPACE_DIR=workspace

## ─── Embeddings ─────────────────────────────────────────────
## Provider: hash (zero-dep, default), openai, none
## hash: deterministic hash embeddings for testing
## openai: OpenAI text-embedding (requires OPENAI_API_KEY)
## none: disable vector search, use text search only
# AGENTBASE_EMBEDDING__PROVIDER=hash

## ─── Web Search ─────────────────────────────────────────────
## Provider: duckduckgo (no key), tavily, none
# AGENTBASE_WEB_SEARCH__PROVIDER=duckduckgo

## Tavily API key (if using tavily)
# TAVILY_API_KEY=

## ─── Tracing ────────────────────────────────────────────────
## Provider: null (default), memory, langfuse
# AGENTBASE_TRACER__PROVIDER=null

## Langfuse (if using langfuse)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

## ─── MCP ────────────────────────────────────────────────────
## Provider: none (default), memory
# AGENTBASE_MCP__PROVIDER=none

## ─── Queue ──────────────────────────────────────────────────
## Provider: none (default, sync), memory (async in-process)
# AGENTBASE_QUEUE__PROVIDER=none

## ─── Storage Override ───────────────────────────────────────
## Override storage type (for testing or SQLite dev mode)
## Set to sqlite to use SQLite instead of PostgreSQL
# AGENTBASE_STORAGE__TYPE=sqlite
# AGENTBASE_STORAGE__DB_DIR=data

## ─── Checkpointer Override ─────────────────────────────────
## Override checkpointer type
## Set to memory for testing (no persistence)
# AGENTBASE_CHECKPOINTER__TYPE=memory

## ─── Health Check ───────────────────────────────────────────
## The health endpoint (/health) checks storage, queue, and auth connectivity.
## Disable if you don't want dependency health checks.
# AGENTBASE_HEALTH_CHECK__STORAGE=true
# AGENTBASE_HEALTH_CHECK__QUEUE=true
# AGENTBASE_HEALTH_CHECK__AUTH=true

## ─── Model Management ───────────────────────────────────────
## Multi-model CRUD and connectivity testing service.
## When enabled, register/query/update/delete model configurations
## via the /models API endpoints and test model connectivity.
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_MODEL_MANAGER__ENABLED=false
# AGENTBASE_MODEL_MANAGER__PROVIDER=memory

## ── Prompt Template Management ──────────────────────────────────────
## When enabled, register/query/update/delete prompt templates
## via the /prompts API endpoints and render them with variables.
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_PROMPT_MANAGER__ENABLED=false
# AGENTBASE_PROMPT_MANAGER__PROVIDER=memory

## User Manager Configuration
## Enable user management for CRUD operations, authentication, and password hashing.
## When enabled, users can register, login, and be managed via /users and /auth API endpoints.
## Passwords are hashed with PBKDF2-HMAC-SHA256 (100k rounds, salted).
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_USER_MANAGER__ENABLED=false
# AGENTBASE_USER_MANAGER__PROVIDER=memory

## ─── OAuth2 Third-Party Login ─────────────────────────────
## Enable Google/GitHub OAuth2 login (authorization code flow).
## When enabled, users can log in via Google or GitHub accounts.
## Auto-registers new users or matches existing users by email.
## Issues JWT tokens for authenticated sessions.
##
## Prerequisites:
## 1. Create OAuth2 credentials in Google Cloud Console / GitHub Developer Settings
## 2. Set the redirect URI to: http://localhost:8000/auth/oauth2/{provider}/callback
## 3. Enable user_manager (above) for auto-registration
##
## Google: https://console.cloud.google.com/apis/credentials
## GitHub: https://github.com/settings/developers
# AGENTBASE_OAUTH2__ENABLED=true
# AGENTBASE_OAUTH2__PROVIDERS__GOOGLE__CLIENT_ID=xxx.apps.googleusercontent.com
# AGENTBASE_OAUTH2__PROVIDERS__GOOGLE__CLIENT_SECRET=
# AGENTBASE_OAUTH2__PROVIDERS__GOOGLE__REDIRECT_URI=http://localhost:8000/auth/oauth2/google/callback
# AGENTBASE_OAUTH2__PROVIDERS__GITHUB__CLIENT_ID=Iv1.xxx
# AGENTBASE_OAUTH2__PROVIDERS__GITHUB__CLIENT_SECRET=
# AGENTBASE_OAUTH2__PROVIDERS__GITHUB__REDIRECT_URI=http://localhost:8000/auth/oauth2/github/callback

## ─── Token Usage Tracking ──────────────────────────────────
## Track prompt/completion/total tokens + estimated USD cost
## for every model invocation. Provides /usage/* API endpoints.
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_USAGE__ENABLED=true
# AGENTBASE_USAGE__PROVIDER=memory
# AGENTBASE_USAGE__MAX_RECORDS=100000

## ─── Webhook ──────────────────────────────────────────────────
## Webhook event notification service. Register endpoints to receive
## HTTP POST notifications for agent lifecycle events.
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_WEBHOOK__ENABLED=true
# AGENTBASE_WEBHOOK__PROVIDER=memory
# AGENTBASE_WEBHOOK__TIMEOUT_SECONDS=10.0
# AGENTBASE_WEBHOOK__MAX_RETRIES=3
# AGENTBASE_WEBHOOK__RETRY_BACKOFF=1.0

## ─── Feedback ─────────────────────────────────────────────────
## User feedback collection. Record ratings (1-5 stars or thumbs
## up/down), comments, and tags for agent responses.
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_FEEDBACK__ENABLED=true
# AGENTBASE_FEEDBACK__PROVIDER=memory
# AGENTBASE_FEEDBACK__MAX_RECORDS=50000

## ─── Notification Center ────────────────────────────────────────
## In-app notification management. Create, query, mark-as-read,
## and broadcast notifications for users (system announcements,
## quota alerts, task completion, threshold warnings, etc.).
## Provider: memory (default, in-process), null (disabled)
# AGENTBASE_NOTIFICATION__ENABLED=true
# AGENTBASE_NOTIFICATION__PROVIDER=memory
# AGENTBASE_NOTIFICATION__MAX_RECORDS=100000

# Conversation history service — record and query conversation messages
# AGENTBASE_CONVERSATION__ENABLED=true
# AGENTBASE_CONVERSATION__PROVIDER=memory
# AGENTBASE_CONVERSATION__MAX_CONVERSATIONS=10000
